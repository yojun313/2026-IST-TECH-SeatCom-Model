{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seatcom:static-library-layout:1.1",
  "title": "공공도서관 정적 좌석·시설 최종 번들 구조",
  "description": "최종 구축 번들 v1.1. 기존 v1.0에 도서관/열람실 마스터·열람실 특성·이미지 경로를 보완. 수집 후보 CSV와 API camelCase는 별도 형식. null은 미확인이며 false/0과 다르다. 관계 ID·범위·측정단위는 별도 검증.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/map"
      }
    },
    "seats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seat"
      }
    },
    "map_transforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/map_transform"
      }
    },
    "walkway_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/walkway_node"
      }
    },
    "walkway_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/walkway_edge"
      }
    },
    "seat_features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seat_feature"
      }
    },
    "facilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/facility"
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/library"
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "room_features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/room_feature"
      }
    },
    "library_id": {
      "type": "string",
      "description": "번들 단일 도서관을 편리하게 식별하는 선택 필드. 배열 레코드의 library_id가 기본 기준."
    }
  },
  "required": [
    "schema_version",
    "sources",
    "maps",
    "seats",
    "facilities",
    "map_transforms",
    "walkway_nodes",
    "walkway_edges",
    "seat_features",
    "libraries",
    "rooms",
    "room_features"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "public_dataset",
            "official_web",
            "public_work",
            "user_supplied",
            "field_measurement"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "collected_on": {
          "type": "string",
          "format": "date"
        },
        "license_status": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "library_id": {
          "type": "string",
          "description": "도서관별 데이터 필터와 학습 분할을 위한 내부 ID"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "url",
        "sha256",
        "document_date",
        "collected_on",
        "license_status",
        "notes"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "library_id": {
          "type": "string",
          "minLength": 1
        },
        "floor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "room_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "pixel",
            "meter"
          ]
        },
        "origin": {
          "const": "top_left"
        },
        "x_direction": {
          "const": "right"
        },
        "y_direction": {
          "const": "down"
        },
        "meters_per_unit": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        },
        "image_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "map_kind": {
          "enum": [
            "floor_plan",
            "room_plan",
            "seat_button_layout",
            "perspective_illustration"
          ]
        }
      },
      "required": [
        "map_id",
        "library_id",
        "floor_id",
        "room_id",
        "width",
        "height",
        "unit",
        "origin",
        "x_direction",
        "y_direction",
        "meters_per_unit",
        "source_id",
        "verification",
        "image_path",
        "map_kind"
      ],
      "additionalProperties": false
    },
    "seat": {
      "type": "object",
      "properties": {
        "seat_id": {
          "type": "string",
          "minLength": 1
        },
        "external_seat_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "seat_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "library_id": {
          "type": "string",
          "minLength": 1
        },
        "room_id": {
          "type": "string",
          "minLength": 1
        },
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "orientation_degrees": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        },
        "geometry_object_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "좌석 geometry 추출 원본의 객체 ID. 공식 좌석 ID와 구분"
        }
      },
      "required": [
        "seat_id",
        "external_seat_id",
        "seat_label",
        "library_id",
        "room_id",
        "map_id",
        "bbox",
        "orientation_degrees",
        "source_id",
        "verification"
      ],
      "additionalProperties": false
    },
    "facility": {
      "type": "object",
      "properties": {
        "facility_id": {
          "type": "string",
          "minLength": 1
        },
        "library_id": {
          "type": "string",
          "minLength": 1
        },
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "toilet",
            "entrance",
            "air_conditioner",
            "air_diffuser",
            "light",
            "window",
            "outlet",
            "column",
            "water_dispenser",
            "elevator",
            "stairs",
            "wall"
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 3
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 2
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            }
          ]
        },
        "access_point": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        }
      },
      "required": [
        "facility_id",
        "library_id",
        "map_id",
        "type",
        "geometry",
        "access_point",
        "attributes",
        "source_id",
        "verification"
      ],
      "additionalProperties": false
    },
    "map_transform": {
      "type": "object",
      "properties": {
        "from_map_id": {
          "type": "string",
          "minLength": 1
        },
        "to_map_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "affine",
            "homography"
          ]
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 3
        },
        "control_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "minItems": 3
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        }
      },
      "required": [
        "from_map_id",
        "to_map_id",
        "kind",
        "matrix",
        "control_points",
        "source_id",
        "verification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "homography"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "control_points": {
                "minItems": 4
              }
            }
          }
        }
      ]
    },
    "walkway_node": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "kind": {
          "enum": [
            "seat_access",
            "door",
            "corridor",
            "facility_access",
            "floor_connection"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        },
        "library_id": {
          "type": "string",
          "description": "도서관별 데이터 필터와 학습 분할을 위한 내부 ID"
        }
      },
      "required": [
        "node_id",
        "map_id",
        "point",
        "kind",
        "target_id",
        "source_id",
        "verification"
      ],
      "additionalProperties": false
    },
    "walkway_edge": {
      "type": "object",
      "properties": {
        "from_node_id": {
          "type": "string",
          "minLength": 1
        },
        "to_node_id": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "pixel",
            "meter"
          ]
        },
        "accessible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        }
      },
      "required": [
        "from_node_id",
        "to_node_id",
        "length",
        "unit",
        "accessible",
        "source_id",
        "verification"
      ],
      "additionalProperties": false
    },
    "seat_feature": {
      "type": "object",
      "properties": {
        "seat_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "object"
        },
        "method": {
          "enum": [
            "diagram_extraction",
            "field_measurement",
            "sensor",
            "user_report",
            "model_inference"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        },
        "normalized_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "normalization_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "seat_id",
        "name",
        "value",
        "unit",
        "context",
        "method",
        "source_id",
        "confidence",
        "verification"
      ],
      "additionalProperties": false,
      "description": "value+unit은 원시 관측값. normalized_value는 features-1 규칙으로 계산하고 버전을 명시한 경우만 제공."
    },
    "library": {
      "type": "object",
      "properties": {
        "library_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "const": "Asia/Seoul"
        },
        "external_ids": {
          "type": "object",
          "properties": {
            "stdg_cd": {
              "type": [
                "string",
                "null"
              ]
            },
            "pblib_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "stdg_cd",
            "pblib_id"
          ],
          "additionalProperties": false
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        }
      },
      "required": [
        "library_id",
        "name",
        "address",
        "latitude",
        "longitude",
        "timezone",
        "external_ids",
        "source_id",
        "verification"
      ],
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1
        },
        "library_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "floor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "assignment": {
          "enum": [
            "assigned",
            "free",
            "unknown"
          ]
        },
        "usage_rules": {
          "type": "object",
          "properties": {
            "laptop_allowed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "keyboard_allowed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "minimum_age": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "maximum_age": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "laptop_allowed",
            "keyboard_allowed",
            "minimum_age",
            "maximum_age"
          ],
          "additionalProperties": false
        },
        "opening_hours": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "timezone": {
                  "const": "Asia/Seoul"
                },
                "weekly": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "day": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                      },
                      "opens": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "closes": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "ends_next_day": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "day",
                      "opens",
                      "closes",
                      "ends_next_day"
                    ],
                    "additionalProperties": false
                  }
                },
                "effective_from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "effective_until": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                }
              },
              "required": [
                "timezone",
                "weekly",
                "effective_from",
                "effective_until"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "model_candidate",
            "human_checked",
            "field_verified"
          ]
        },
        "external_room_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "원본 기관/서비스의 열람실 ID"
        },
        "official_room_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "공식 원본에서 확인한 열람실 식별자"
        },
        "external_room_id_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "opening_hours_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "capacity_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "room_id",
        "library_id",
        "name",
        "floor_id",
        "capacity",
        "assignment",
        "usage_rules",
        "opening_hours",
        "source_id",
        "verification"
      ],
      "additionalProperties": false
    },
