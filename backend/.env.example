# Copy to backend/.env. Do NOT commit secrets.
# SeatCom app
DATABASE_PATH=backend/runtime/seatcom.sqlite3
ATTACHMENT_DIR=backend/runtime/attachments
GMAIL_RECIPIENT=taywook74@gmail.com
GMAIL_AUTH_DIR=backend/runtime/gmail
CORS_ORIGINS=http://localhost:3000
UPLOAD_EXPIRY_MINUTES=30
MAX_TXT_BYTES=5000000

# JWT: 자체 로그인(/api/v1/auth/*)이 HS256으로 발급한다. 외부 인증 서버를 쓰면 RS256 공개키로 바꾼다.
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_PUBLIC_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=
# For isolated tests ONLY: AUTH_JWT_ALGORITHM=HS256, AUTH_JWT_SECRET=...
AUTH_JWT_SECRET=

# Internal service authentication
INTERNAL_SERVICE_TOKEN=

# Worker and Gmail poller (Gmail disabled unless credentials provisioned)
LAB_WORKER_ENABLED=true
LAB_WORKER_POLL_SECONDS=2
GMAIL_POLL_ENABLED=false
GMAIL_POLL_SECONDS=20

# Existing remote KNPU GPT-OSS implementation
OSS_API_KEY=
OSS_BASE_URL=https://llm0.knpu.re.kr/v1
OSS_MODEL=openai/gpt-oss-120b
OSS_TIMEOUT=180
OSS_MAX_WORKERS=3
OSS_MAX_COMPLETION_TOKENS=2000
OSS_REASONING_EFFORT=low

# 회원가입 이메일 인증(Gmail SMTP 앱 비밀번호)
MAIL_SENDER=
MAIL_PASSWORD=
# 프론트 가짜 로그인 토큰 허용(개발용). 운영은 false
ALLOW_GUEST_TOKENS=false
# 좌석 추천 모델 폴더
SEAT_MODEL_DIR=seat_model/models/v1-20261115
